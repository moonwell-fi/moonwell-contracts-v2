{
    "mcpServers": {
        "context7": {
            "command": "npx",
            "args": ["-y", "@upstash/context7-mcp@latest"]
        },
        "evm-rpc": {
            "command": "npx",
            "args": ["-y", "@mcpdotdirect/evm-mcp-server"],
            "env": {
                "ETHEREUM_RPC_URL": "${ETH_RPC_URL}",
                "BASE_RPC_URL": "${BASE_RPC_URL}",
                "OPTIMISM_RPC_URL": "${OP_RPC_URL}",
                "MOONBEAM_RPC_URL": "${MOONBEAM_RPC_URL}"
            }
        }
    }
}
